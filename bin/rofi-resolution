#!/usr/bin/env bash
#
# rofi-resolution
#
# Rofi menu restricted to 3:2 aspect-ratio resolutions on eDP-1.
# Ensures the curated modes exist, marks the currently active one,
# applies the selection.

OUTPUT="eDP-1"
NATIVE="2256x1504"

# Defensive: guarantee the menu always has options even if the
# i3-startup call somehow hasn't run yet this session
~/.local/bin/xrandr-3-2-modes

# Mode list is defined once, in xrandr-3-2-modes
mapfile -t EXTRA_MODES < <(~/.local/bin/xrandr-3-2-modes --list)

CURRENT=$(xrandr --query | awk -v out="$OUTPUT" '
    /^[^ ]/ { active = ($1 == out); next }
    active && /\*/ { print $1; exit }
')

{
    echo "$NATIVE"
    printf '%s\n' "${EXTRA_MODES[@]}"
} | awk -v cur="$CURRENT" '{ print ($0 == cur) ? $0 " (current)" : $0 }' \
  | rofi -dmenu -p "Resolution (3:2)" \
  | sed 's/ (current)$//' \
  | while read -r selection; do
        [ -z "$selection" ] && exit 0
        if xrandr --output "$OUTPUT" --mode "$selection"; then
            dunstify -a "rofi-resolution" "Resolution changed" "$OUTPUT now at $selection"
            ~/.local/bin/polybar-launch  # re-trigger bar geometry detection
        else
            dunstify -a "rofi-resolution" -u critical "Resolution change failed" "$selection not available"
        fi
    done
