#!/usr/bin/env bash
#
# xrandr-3-2-modes
#
# Idempotently ensures a curated set of 3:2 aspect-ratio resolutions
# exist as modes on eDP-1. Safe to run repeatedly — skips anything
# already present. Native 2256x1504 is already 3:2 and always
# available, so it isn't added here.
#
# Session-scoped: hook into i3 startup (config.d/galileo) since the
# mode pool resets at every X start.

OUTPUT="eDP-1"

# Candidates to add, in menu order — edit freely, all exactly 3:2.
# This is the single source of truth: rofi-resolution reads it via --list.
# Others at 3:2: 1200x800 1350x900 1500x1000 1620x1080 1692x1128
MODES=(2016x1344 1800x1200)

if [[ "$1" == "--list" ]]; then
    printf '%s\n' "${MODES[@]}"
    exit 0
fi

if ! command -v cvt >/dev/null; then
    dunstify -a "xrandr-3-2-modes" -u critical "cvt not found" "Install with: sudo pacman -S libxcvt"
    exit 1
fi

EXISTING=$(xrandr --query | awk -v out="$OUTPUT" '
    /^[^ ]/ { active = ($1 == out); next }
    active && /^[[:space:]]+[0-9]+x[0-9]+/ { print $1 }
')

for res in "${MODES[@]}"; do
    grep -qx "$res" <<< "$EXISTING" && continue  # already present, skip

    w="${res%x*}"; h="${res#*x}"
    line=$(cvt "$w" "$h" 60 | grep Modeline)
    params=$(echo "$line" | sed -E 's/^Modeline +"[^"]+" +//')

    # Use the plain resolution string as the mode name (not cvt's "_60.00"
    # suffixed default) so idempotency checks and the rofi menu stay clean
    xrandr --newmode "$res" $params 2>/dev/null
    xrandr --addmode "$OUTPUT" "$res" 2>/dev/null
done
